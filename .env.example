# Copy this file to .env and fill in the values. Never commit .env.
# Do NOT prefix with VITE_ (it would be exposed in the browser bundle).

# Higgsfield API key(s) from https://open.higgsfield.ai/api-keys
HIGGSFIELD_API_KEY=
# If the site issues an ID + Secret pair, use these instead:
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# Figma personal access token (Settings > Security)
FIGMA_TOKEN=

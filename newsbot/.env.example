# ===== 필수에 가까운 것 =====
# OpenDART(https://opendart.fss.or.kr) 인증키. 비워두면 DART 수집 없이 화면만 뜹니다.
DART_API_KEY=

# AI: claude 또는 openai. 키를 넣으면 질문·기사 초안·스타일북·AI 브리핑이 켜집니다.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 알림 모드: log = 기록만(처음 2주 권장), notify = 팝업·푸시 알림 보냄
ALERT_MODE=log

# ===== 접속 =====
# 사내망에서 다른 PC가 접속하려면 HOST=0.0.0.0 (단, 알림은 HTTPS 또는 localhost에서만 동작)
HOST=127.0.0.1
PORT=8000
# 외부 접속 주소 (터널을 쓰면 https://briefing.도메인). 초대 링크와 푸시에 쓰입니다.
PUBLIC_URL=http://localhost:8000
# 웹 푸시 발신자 연락처 (mailto: 또는 https 주소)
VAPID_CONTACT=mailto:admin@example.com

# ===== AI 세부 =====
# 모델 (기본값: 브리핑 fast / 질문 main / 초안·스타일북 draft)
CLAUDE_MODEL_FAST=claude-haiku-5-5
CLAUDE_MODEL_MAIN=claude-sonnet-5-5
CLAUDE_MODEL_DRAFT=claude-opus-5-5
# OpenAI 모델명은 OpenAI 콘솔에서 확인 후 고쳐 주세요 (아래는 공개 요금 정리 글 기준 이름)
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_MAIN=gpt-6.1-sol
OPENAI_MODEL_DRAFT=gpt-6.1-sol
# 기자 1인당 월 AI 사용 한도(원). 관리자 화면에서 사람별로 바꿀 수 있습니다.
MONTHLY_LIMIT_KRW=30000
USD_KRW=1400

# ===== 알리오 =====
ALIO_ENABLED=true
ALIO_POLL_HOURS=6
# 알리오 접속에서 SSL 인증서 오류가 나면 false
ALIO_VERIFY_SSL=true

# ===== 보도자료 메일 (법무·IT 검토 후에만 켜세요) =====
MAIL_ENABLED=false
# 메일 본문을 해외 AI API로 보내 초안을 쓰는 것 (개인정보 국외 이전 검토 필요)
MAIL_AI_SUMMARY=false
MAIL_POLL_MINUTES=5

# ===== 기타 =====
DIGEST_TIMES=08:00,13:00,18:00,23:00
DB_PATH=data/newsbot.db
RULES_PATH=config/rules.toml
ALIO_PATH=config/alio.toml
POLL_INTERVAL_SEC=300
DART_RESCAN_PAGES=3
DART_DAILY_CALL_LIMIT=18000

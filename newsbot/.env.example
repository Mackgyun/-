# OpenDART(https://opendart.fss.or.kr) 인증키. 비워두면 수집 없이 화면만 뜹니다.
DART_API_KEY=

# 알림 모드: log = 기록만(처음 2주 권장), notify = 팝업·푸시 알림 보냄
ALERT_MODE=log

# 웹앱 주소와 포트. 사내망에서 다른 PC가 접속하려면 HOST=0.0.0.0
HOST=127.0.0.1
PORT=8000
# 외부에서 접속하는 주소 (터널을 쓰면 https://브리핑.도메인). 초대 링크와 푸시에 쓰입니다.
PUBLIC_URL=http://localhost:8000

# 푸시 알림 발신자 연락처 (웹 푸시 규격상 필요, mailto: 또는 https 주소)
VAPID_CONTACT=mailto:admin@example.com

# 이하 선택 항목
DB_PATH=data/newsbot.db
RULES_PATH=config/rules.toml
POLL_INTERVAL_SEC=300
DART_RESCAN_PAGES=3
DART_DAILY_CALL_LIMIT=18000
